<?xml version="1.0"?>
<odoo noupdate="0">

    <!-- Bước 6 "Lập BB thay tem": chọn nhiều Cửa hàng và xuất biên bản thay tem,
         đặt ngay trong tab "Chi tiết công việc" phía trên bảng "Chi tiết tem/tag". -->
    <record id="view_ctkm_task_form_bb_export" model="ir.ui.view">
        <field name="name">ctkm.task.form.bb.export</field>
        <field name="model">ctkm.task</field>
        <field name="inherit_id" ref="ctkm_core.view_ctkm_task_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='task_detail']//group[@name='tem_tag_detail_group']"
                position="before">
                <group string="Xuất biên bản thay tem"
                    invisible="not is_tem_bb_replace_task and not is_tem_replace_task">
                    <field name="bb_export_store_domain_ids" invisible="1"/>
                    <field name="store_ids" widget="many2many_tags"
                        domain="[('id', 'in', bb_export_store_domain_ids)]"
                        options="{'no_create': True}"
                        help="Chỉ chọn được các cửa hàng vừa có dữ liệu Tem/Tag import bước 4, vừa thuộc 'Cửa hàng quản lí' của nhân viên nhận việc. Bỏ trống để xuất tất cả cửa hàng của bạn."/>
                    <div colspan="2" class="mt-2">
                        <button name="action_export_bb_file" type="object"
                            string="Xuất file" class="btn-primary"
                            icon="fa-file-excel-o"
                            invisible="not is_tem_bb_replace_task and not is_tem_replace_task"/>
                    </div>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
