<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">
        <!-- Nhân viên cửa hàng: tem/tag của cửa hàng mình.
             Người nhận việc bước "Đổ BB thay tem/tag (file tổng)": toàn bộ tem/tag
             của CTKM đó (họ là người import file tổng cho mọi cửa hàng). -->
        <record id="ctkm_inventory_tem_tag_rule_store_user" model="ir.rule">
            <field name="name">CTKM Inventory Tem/Tag: same employee store</field>
            <field name="model_id" ref="model_ctkm_inventory_tem_tag"/>
            <field name="domain_force">['|',
                ('store_key', 'in', user.env['ctkm.inventory.tem.tag'].current_user_store_keys()),
                ('program_id.task_ids', 'any', [('user_ids', 'in', [user.id]), ('is_tem_tag_import_task', '=', True)])]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="ctkm_inventory_tem_tag_rule_ctkm_user" model="ir.rule">
            <field name="name">CTKM Inventory Tem/Tag: CTKM user all stores</field>
            <field name="model_id" ref="model_ctkm_inventory_tem_tag"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('ctkm_core.group_ctkm_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="ctkm_inventory_tem_tag_rule_manager_all" model="ir.rule">
            <field name="name">CTKM Inventory Tem/Tag: manager all stores</field>
            <field name="model_id" ref="model_ctkm_inventory_tem_tag"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('ctkm_core.group_ctkm_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
</odoo>
