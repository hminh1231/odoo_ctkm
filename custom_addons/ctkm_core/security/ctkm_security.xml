        <record id="ctkm_task_tem_postcheck_rule_user" model="ir.rule">
            <field name="name">CTKM Hậu kiểm: user xem toàn bộ (báo cáo)</field>
            <field name="model_id" ref="model_ctkm_task_tem_postcheck_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_ctkm_user'))]"/>
        </record>
