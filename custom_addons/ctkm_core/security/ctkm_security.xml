            <field name="name">CTKM Hậu kiểm: dòng của công việc mình phụ trách</field>
            <field name="model_id" ref="model_ctkm_task_tem_postcheck_line"/>
            <field name="domain_force">['|',
                ('task_id.user_ids', '=', user.id),
