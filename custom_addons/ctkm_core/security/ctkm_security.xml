<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">
        <record model="res.groups.privilege" id="res_groups_privilege_ctkm">
            <field name="name">Chương trình khuyến mãi</field>
            <field name="sequence">19</field>
            <field name="category_id" ref="base.module_category_marketing"/>
        </record>

        <record id="group_ctkm_user" model="res.groups">
            <field name="name">User</field>
            <field name="sequence">10</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="privilege_id" ref="res_groups_privilege_ctkm"/>
        </record>

        <record id="group_ctkm_manager" model="res.groups">
            <field name="name">Administrator</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_ctkm"/>
            <field name="implied_ids" eval="[(4, ref('group_ctkm_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- CTKM users/managers: full visibility -->
        <record id="ctkm_program_rule_user" model="ir.rule">
            <field name="name">CTKM: user xem toàn bộ chương trình</field>
            <field name="model_id" ref="model_ctkm_program"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_ctkm_user'))]"/>
        </record>

        <!-- Internal users without CTKM rights: only programs they are notified of / responsible for -->
        <record id="ctkm_program_rule_notify_recipient" model="ir.rule">
            <field name="name">CTKM: người nhận thông báo được xem CTKM</field>
            <field name="model_id" ref="model_ctkm_program"/>
            <field name="domain_force">['|', ('user_id', '=', user.id), ('notify_line_ids.notify_employee_ids.user_id', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <!-- Người nhận việc: xem CTKM của công việc được giao (form công việc, wizard import...) -->
        <record id="ctkm_program_rule_task_assignee" model="ir.rule">
            <field name="name">CTKM: người nhận việc xem CTKM được giao</field>
            <field name="model_id" ref="model_ctkm_program"/>
            <field name="domain_force">[('task_ids.user_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <!-- Người kiểm soát: xem CTKM của công việc mình phải xác nhận -->
        <record id="ctkm_program_rule_verifier" model="ir.rule">
            <field name="name">CTKM: Người kiểm soát xem CTKM cần xác nhận</field>
            <field name="model_id" ref="model_ctkm_program"/>
            <field name="domain_force">['|',
                ('task_ids.verifier_ids.user_id', 'in', [user.id]),
                ('task_ids.store_verifier_ids.verifier_user_id', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <!-- Quản lý org-chart: xem CTKM của cấp dưới (để xác nhận hoàn thành + xem tài liệu) -->
        <record id="ctkm_program_rule_org_manager" model="ir.rule">
            <field name="name">CTKM: quản lý org-chart xem CTKM cấp dưới</field>
            <field name="model_id" ref="model_ctkm_program"/>
            <field name="domain_force">[('task_ids.user_ids', 'in', user.employee_ids.child_ids.user_id.ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Tasks: CTKM user thấy việc của mình; manager thấy tất cả -->
        <record id="ctkm_task_rule_user" model="ir.rule">
            <field name="name">CTKM Task: user xem công việc của mình</field>
            <field name="model_id" ref="model_ctkm_task"/>
            <field name="domain_force">[('user_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('group_ctkm_user'))]"/>
        </record>
        <record id="ctkm_task_rule_manager" model="ir.rule">
            <field name="name">CTKM Task: manager xem toàn bộ</field>
            <field name="model_id" ref="model_ctkm_task"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_ctkm_manager'))]"/>
        </record>
        <!-- Nhân viên (mở từ Discuss): tạo/sửa công việc của chính mình -->
        <record id="ctkm_task_rule_notify_recipient" model="ir.rule">
            <field name="name">CTKM Task: nhân viên quản lý việc của mình</field>
            <field name="model_id" ref="model_ctkm_task"/>
            <field name="domain_force">[('user_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <!-- Người kiểm soát xem/xác nhận công việc được gán kiểm soát -->
        <record id="ctkm_task_rule_verifier" model="ir.rule">
            <field name="name">CTKM Task: Người kiểm soát xác nhận</field>
            <field name="model_id" ref="model_ctkm_task"/>
            <field name="domain_force">['|',
                ('verifier_ids.user_id', 'in', [user.id]),
                ('store_verifier_ids.verifier_user_id', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <!-- Quản lý trực tiếp (org chart) xem/xác nhận công việc cấp dưới -->
        <record id="ctkm_task_rule_org_manager" model="ir.rule">
            <field name="name">CTKM Task: quản lý org-chart xác nhận cấp dưới</field>
            <field name="model_id" ref="model_ctkm_task"/>
            <field name="domain_force">[('user_ids', 'in', user.employee_ids.child_ids.user_id.ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Chi tiết tem/tag: chỉ dòng thuộc công việc của mình / của cấp dưới -->
        <record id="ctkm_task_tem_tag_line_rule_employee" model="ir.rule">
            <field name="name">CTKM Chi tiết tem/tag: dòng của công việc mình phụ trách</field>
            <field name="model_id" ref="model_ctkm_task_tem_tag_replace_line"/>
            <field name="domain_force">['|',
                ('task_id.user_ids', '=', user.id),
                ('task_id.user_ids', 'in', user.employee_ids.child_ids.user_id.ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="ctkm_task_tem_tag_line_rule_manager" model="ir.rule">
            <field name="name">CTKM Chi tiết tem/tag: manager xem toàn bộ</field>
            <field name="model_id" ref="model_ctkm_task_tem_tag_replace_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_ctkm_manager'))]"/>
        </record>
        <!-- Global (AND với mọi rule nhóm): bước 11/12 chỉ hiện store của người đang xem.
             Rule gắn group bị OR với "là người nhận việc" nên không chặn được store khác. -->
        <record id="ctkm_task_tem_tag_line_rule_own_store" model="ir.rule">
            <field name="name">CTKM Chi tiết tem/tag: chỉ store của mình (bước 11–12)</field>
            <field name="model_id" ref="model_ctkm_task_tem_tag_replace_line"/>
            <field name="groups" eval="[(5, 0, 0)]"/>
            <field name="domain_force">['|',
                ('id', '>' if user.has_group('ctkm_core.group_ctkm_manager') else '=', 0),
                '|',
                    '&amp;',
                        ('task_id.is_tem_receive_task', '=', False),
                        ('task_id.is_tem_replace_task', '=', False),
                    ('store_key', 'in', user.env['ctkm.task']._ctkm_visible_store_keys_for_user(user))]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="ctkm_task_tem_photo_line_rule_own_store" model="ir.rule">
            <field name="name">CTKM Kiểm tra ảnh: chỉ store của mình</field>
            <field name="model_id" ref="model_ctkm_task_tem_photo_line"/>
            <field name="groups" eval="[(5, 0, 0)]"/>
            <field name="domain_force">['|',
                ('id', '>' if user.has_group('ctkm_core.group_ctkm_manager') else '=', 0),
                '|',
                    ('task_id.is_tem_check_task', '=', False),
                    ('store_key', 'in', user.env['ctkm.task']._ctkm_visible_store_keys_for_user(user))]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="ctkm_task_tem_photo_line_rule_manager" model="ir.rule">
            <field name="name">CTKM Kiểm tra ảnh: manager xem toàn bộ</field>
            <field name="model_id" ref="model_ctkm_task_tem_photo_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_ctkm_manager'))]"/>
        </record>

        <!-- Thu hồi tem: chỉ dòng thuộc công việc của mình / của cấp dưới -->
        <record id="ctkm_task_tem_tag_recover_rule_employee" model="ir.rule">
            <field name="name">CTKM Thu hồi tem: dòng của công việc mình phụ trách</field>
            <field name="model_id" ref="model_ctkm_task_tem_tag_recover_line"/>
            <field name="domain_force">['|',
