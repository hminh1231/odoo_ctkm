<?xml version="1.0"?>
<odoo noupdate="0">

    <record model="ir.ui.view" id="view_ctkm_stage_tree">
        <field name="name">ctkm.stage.list</field>
        <field name="model">ctkm.stage</field>
        <field name="arch" type="xml">
            <list string="Giai đoạn" editable="bottom">
                <field name="sequence" string="STT" widget="handle"/>
                <field name="name" string="Tên giai đoạn"/>
                <field name="user_id" string="Phụ trách" widget="many2one_avatar_user"/>
                <field name="need_manager_confirm" string="Cần quản lý xác nhận" widget="boolean_toggle"/>
                <field name="verifier_id" string="Người kiểm soát"
                    column_invisible="not need_manager_confirm"/>
            </list>
        </field>
    </record>

    <record model="ir.ui.view" id="view_ctkm_stage_form">
        <field name="name">ctkm.stage.form</field>
        <field name="model">ctkm.stage</field>
        <field name="arch" type="xml">
            <form string="Giai đoạn">
                <sheet>
                    <group>
                        <field name="sequence" string="STT"/>
                        <field name="name" string="Tên giai đoạn"/>
                        <field name="user_id" string="Phụ trách"/>
                        <field name="need_manager_confirm" string="Cần quản lý xác nhận"/>
                        <field name="verifier_id" string="Người kiểm soát"
                            invisible="not need_manager_confirm"
                            domain="[('user_id.share', '=', False)]"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_ctkm_stage_view">
       <field name="name">Giai đoạn</field>
       <field name="res_model">ctkm.stage</field>
       <field name="view_mode">list,form</field>
       <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Tạo giai đoạn mới
          </p>
       </field>
    </record>

    <record id="menu_ctkm_stage" model="ir.ui.menu">
        <field name="action" ref="action_ctkm_stage_view"/>
    </record>

</odoo>
