<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="0">

    <!-- List: gọn như hình 3 -->
    <record id="view_ctkm_task_list" model="ir.ui.view">
        <field name="name">ctkm.task.list</field>
        <field name="model">ctkm.task</field>
        <field name="arch" type="xml">
            <list string="Công việc của tôi" create="0" delete="0"
                class="o_ctkm_task_list">
                <field name="process_date"/>
                <field name="checklist_step_name"/>
                <field name="name" optional="show"/>
                <field name="user_id" optional="hide" readonly="1"
                    options="{'no_create': True, 'no_open': True}"/>
                <field name="done_date"/>
                <field name="state" widget="selection_badge" readonly="1"/>
                <field name="duration" optional="show"/>
                <field name="program_id" optional="hide"
                    options="{'no_create': True, 'no_open': True}"/>
            </list>
        </field>
    </record>

    <!-- Form: header CTKM readonly + chỉ Ghi chú & Tài liệu -->
    <record id="view_ctkm_task_form" model="ir.ui.view">
        <field name="name">ctkm.task.form</field>
        <field name="model">ctkm.task</field>
        <field name="arch" type="xml">
            <form string="Công việc của tôi" create="0" delete="0">
                <header>
                    <field name="is_task_assignee" invisible="1"/>
                    <field name="can_confirm_as_manager" invisible="1"/>
                    <field name="checklist_need_manager_confirm" invisible="1"/>
                    <button name="action_mark_done" type="object"
                        string="Hoàn thành" class="btn-primary" icon="fa-check"
                        invisible="not is_task_assignee or manager_confirmed or state == 'done'"/>
                    <button name="action_manager_confirm" type="object"
                        string="Xác nhận quản lý" class="btn-primary" icon="fa-check-square-o"
                        invisible="not can_confirm_as_manager or state != 'waiting_confirm' or manager_confirmed or not checklist_need_manager_confirm"/>
                    <button name="action_advance_stage" type="object"
                        string="Chuyển tiếp" class="btn-secondary" icon="fa-forward"
                        invisible="state != 'done' or not manager_confirmed or forwarded"/>
                    <field name="forwarded" invisible="1"/>
                    <field name="program_stage_id" widget="statusbar"/>
                    <field name="state" invisible="1"/>
                </header>
                <sheet>
                    <field name="program_id" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <field name="name" invisible="1"/>
                    <field name="program_kanban_state" widget="statusbar"
                        class="ms-auto float-end"/>
                    <div class="oe_title">
                        <label for="program_name" string="Tên chương trình"/>
                        <h1>
                            <field name="program_name" readonly="1"
                                placeholder="Chưa gắn chương trình khuyến mãi"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="program_date_begin" string="Ngày"
                                widget="daterange"
                                options="{'end_date_field': 'program_date_end'}"
                                readonly="1"/>
                            <field name="program_date_end" invisible="1"/>
                            <field name="program_notify_code" readonly="1"/>
                            <field name="program_hour_quota" readonly="1"
                                placeholder="VD: 8 giờ"/>
                        </group>
                        <group>
                            <field name="program_organizer_id" readonly="1"/>
                            <field name="program_user_id" readonly="1"
                                widget="many2one_avatar_user"/>
                            <field name="program_company_id" readonly="1"
                                groups="base.group_multi_company"/>
                            <field name="program_address_id" readonly="1"
                                context="{'show_address': 1}"/>
                            <field name="program_event_url" readonly="1"
                                invisible="program_address_id" widget="url"/>
                            <label for="program_seats_limited" string="Giới hạn đăng ký"/>
                            <div>
                                <field name="program_seats_limited" readonly="1"/>
                                <span invisible="not program_seats_limited">
                                   đến <field name="program_seats_max" class="oe_inline" readonly="1"/> Người tham gia
                                </span>
                            </div>
                        </group>
                    </group>
                    <notebook>
                        <page string="Ghi chú &amp; Tài liệu" name="task_notes">
                            <group>
                                <group string="Nhãn chương trình">
                                    <field name="program_badge_format" readonly="1"/>
                                    <field name="program_badge_image" widget="image"
                                        readonly="1"
                                        options="{'accepted_file_extensions': 'image/*'}"/>
                                </group>
                                <group string="Tài liệu gửi kèm thông báo">
                                    <field name="program_notify_document_ids"
                                        widget="many2many_binary" nolabel="1" colspan="2"
                                        readonly="1"/>
                                </group>
                                <group string="Nhận từ chương trình / bước trước"
                                    invisible="not handover_note and not handover_document_ids">
                                    <field name="notify_step_label" readonly="1"/>
                                    <label for="handover_note" string="Ghi chú nhận được"/>
                                    <br/>
                                    <field name="handover_note" nolabel="1" colspan="2"
                                        readonly="1"/>
                                    <field name="handover_document_ids"
                                        widget="many2many_binary" nolabel="1" colspan="2"
                                        readonly="1"/>
                                </group>
                                <group>
                                    <label for="program_ticket_instructions" string="Hướng dẫn vé"/>
                                    <br/>
                                    <field name="program_ticket_instructions" nolabel="1"
                                        colspan="2" readonly="1"/>
                                </group>
                                <group>
                                    <label for="program_note" string="Ghi chú chương trình"/>
                                    <br/>
                                    <field name="program_note" nolabel="1" colspan="2"
                                        readonly="1"/>
                                </group>
                                <group string="Ghi chú &amp; tài liệu của tôi">
                                    <field name="work_note" nolabel="1" colspan="2"
                                        placeholder="Thêm ghi chú của bạn..."/>
                                    <field name="work_document_ids" widget="many2many_binary"
                                        nolabel="1" colspan="2"
                                        options="{'accepted_file_extensions': '.pdf,.doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg'}"/>
                                </group>
                            </group>
                        </page>
                        <page string="Yêu cầu hỗ trợ" name="task_support">
                            <group>
                                <group>
                                    <field name="handover_date"/>
                                    <field name="handover_employee_id"
                                        options="{'no_create': True}"/>
                                    <field name="duration" placeholder="VD: 2 giờ"/>
                                </group>
                                <group>
                                    <field name="support_employee_ids" widget="many2many_tags"
                                        options="{'no_create': True}"/>
                                    <div colspan="2" class="mt-2">
                                        <button name="action_notify_support" type="object"
                                            string="Gửi yêu cầu hỗ trợ" class="btn-primary"
                                            icon="fa-bell"/>
                                    </div>
                                </group>
                            </group>
                        </page>
                        <page string="Xác nhận quản lý" name="task_manager_confirm" invisible="not checklist_need_manager_confirm">
                            <group>
                                <group>
                                    <field name="manager_confirmed"
                                        readonly="state != 'waiting_confirm' or not can_confirm_as_manager"/>
                                    <div colspan="2" class="text-muted"
                                        invisible="state == 'waiting_confirm'">
                                        Chỉ xác nhận được sau khi công việc đã bấm Hoàn thành.
                                    </div>
                                    <div colspan="2" class="text-muted"
                                        invisible="state != 'waiting_confirm' or can_confirm_as_manager">
                                        Chỉ quản lý trực tiếp (theo organization chart) mới được tick xác nhận.
                                    </div>
                                    <div colspan="2" class="text-muted"
                                        invisible="state != 'waiting_confirm' or not can_confirm_as_manager or manager_confirmed">
                                        Bấm nút <b>Xác nhận quản lý</b> trên đầu form, hoặc tick ô bên trên.
                                    </div>
                                </group>
                            </group>
                        </page>
                        <page string="Chi tiết công việc" name="task_detail">
                            <group>
                                <group string="Import Tem/Tag" invisible="not ('Đổ BB thay tem/tag (file tổng)' in (name or '') or 'Đổ BB thay tem/tag(file tổng)' in (name or ''))">
                                    <div class="text-muted mb-2" colspan="2">
                                        Nhấn <b>Import Tem/Tag</b> để tải lên file Excel theo mẫu Kho Tem/Tag.
                                    </div>
                                    <button name="action_open_tem_tag_import" type="object"
                                        string="Import Tem/Tag" class="btn-primary"
                                        icon="fa-file-excel-o"
                                        invisible="not ('Đổ BB thay tem/tag (file tổng)' in (name or '') or 'Đổ BB thay tem/tag(file tổng)' in (name or ''))"/>
                                </group>
                                <group string="Ảnh tem/tag" invisible="not ('Chụp tem gửi lên group / chụp từng con tem' in (name or ''))">
                                    <field name="detail_tem_photo_ids" widget="many2many_binary" nolabel="1" colspan="2"
                                        options="{'accepted_file_extensions': '.png,.jpg,.jpeg,.gif,.webp'}"/>
                                </group>
                                <group string="Thông tin khác" invisible="('Đổ BB thay tem/tag (file tổng)' in (name or '') or 'Đổ BB thay tem/tag(file tổng)' in (name or '')) or ('Chụp tem gửi lên group / chụp từng con tem' in (name or ''))">
                                    <div colspan="2" class="text-muted">
                                        Đang để trống, sẽ bổ sung sau.
                                    </div>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_ctkm_task_search" model="ir.ui.view">
        <field name="name">ctkm.task.search</field>
        <field name="model">ctkm.task</field>
        <field name="arch" type="xml">
            <search string="Công việc của tôi">
                <field name="name"/>
                <field name="program_id"/>
                <field name="user_id"/>
                <filter string="Của tôi" name="my_tasks"
                    domain="[('user_id', '=', uid)]"/>
                <filter string="Chờ tôi xác nhận" name="waiting_my_confirm"
                    domain="[('state', '=', 'waiting_confirm'), ('user_id.employee_ids.parent_id.user_id', '=', uid)]"/>
                <separator/>
                <filter string="Chưa bắt đầu" name="state_todo"
                    domain="[('state', '=', 'todo')]"/>
                <filter string="Đang xử lý" name="state_progress"
                    domain="[('state', '=', 'progress')]"/>
                <filter string="Chờ xác nhận" name="state_waiting_confirm"
                    domain="[('state', '=', 'waiting_confirm')]"/>
                <filter string="Hoàn thành" name="state_done"
                    domain="[('state', '=', 'done')]"/>
                <group>
                    <filter string="Trạng thái" name="group_state"
                        context="{'group_by': 'state'}"/>
                    <filter string="Ngày xử lý" name="group_process_date"
                        context="{'group_by': 'process_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ctkm_task_my" model="ir.actions.act_window">
        <field name="name">Công việc của tôi</field>
        <!-- Không dùng path (ctkm-my-tasks): webclient Odoo 19 đôi khi
             hiểu nhầm path thành model name → RPC 404 KeyError. -->
        <field name="path" eval="False"/>
        <field name="res_model">ctkm.task</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ctkm_task_search"/>
        <!-- Chỉ việc của tôi + việc cấp dưới chờ mình xác nhận (không hiện chung cả hệ thống). -->
        <field name="domain">['|',
            ('user_id', '=', uid),
            '&amp;',
                ('state', '=', 'waiting_confirm'),
                ('user_id.employee_ids.parent_id.user_id', '=', uid)]</field>
        <field name="context">{'search_default_my_tasks': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Chưa có công việc nào.
            </p>
            <p>
                Công việc được tạo tự động từ <b>Tiến độ thực hiện</b> của chương trình,
                hoặc khi bấm <b>Gửi tin</b> trong chương trình.
            </p>
        </field>
    </record>

    <record id="menu_ctkm_my_tasks" model="ir.ui.menu">
        <field name="action" ref="action_ctkm_task_my"/>
    </record>

    <record id="ctkm_main_menu" model="ir.ui.menu">
        <field name="action" ref="action_ctkm_task_my"/>
    </record>

</data>
</odoo>
