<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">

    <!-- List: gọn như hình 3 -->
    <record id="view_ctkm_task_list" model="ir.ui.view">
        <field name="name">ctkm.task.list</field>
        <field name="model">ctkm.task</field>
        <field name="arch" type="xml">
            <list string="Công việc của tôi" create="0" delete="0"
                class="o_ctkm_task_list">
                <field name="process_date"/>
                <field name="program_id" string="Tên CTKM"
                    options="{'no_create': True, 'no_open': False}"/>
                <field name="name" optional="show"/>
                <field name="is_current_stage_task" optional="hide"/>
                <field name="user_ids" optional="hide" readonly="1" widget="many2many_tags"
                    options="{'no_create': True, 'no_open': True}"/>
                <field name="done_date"/>
                <field name="state" widget="selection_badge" readonly="1"/>
                <field name="duration" optional="show"/>
                <field name="program_id" optional="hide"
                    options="{'no_create': True, 'no_open': True}"/>
            </list>
        </field>
    </record>

    <!-- Form: header CTKM readonly + chỉ Ghi chú & Tài liệu -->
    <record id="view_ctkm_task_form" model="ir.ui.view">
        <field name="name">ctkm.task.form</field>
        <field name="model">ctkm.task</field>
        <field name="arch" type="xml">
            <form string="Công việc của tôi" create="0" delete="0">
                <header>
                    <field name="is_task_assignee" invisible="1"/>
                    <field name="can_confirm_as_manager" invisible="1"/>
                    <field name="is_verifier" invisible="1"/>
                    <field name="checklist_need_manager_confirm" invisible="1"/>
                    <field name="manager_confirmed" invisible="1"/>
                    <field name="state" invisible="1"/>
                    <field name="forwarded" invisible="1"/>
                    <button name="action_mark_done" type="object"
                        string="Hoàn thành" class="btn-primary" icon="fa-check"
                        invisible="not is_task_assignee or manager_confirmed or state == 'done'"/>
                    <button name="action_manager_confirm" type="object"
                        string="Xác nhận quản lý" class="btn-primary" icon="fa-check-square-o"
                        invisible="not can_confirm_as_manager or state != 'waiting_confirm' or manager_confirmed or not checklist_need_manager_confirm"/>
                    <button name="action_advance_stage" type="object"
                        string="Chuyển tiếp" class="btn-secondary" icon="fa-forward"
                        invisible="state != 'done' or forwarded or (checklist_need_manager_confirm and not manager_confirmed)"/>
                    <field name="program_stage_id" widget="statusbar"/>
                </header>
                <sheet>
                    <field name="program_id" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <field name="name" invisible="1"/>
                    <field name="is_tem_tag_import_task" invisible="1"/>
                    <field name="is_tem_photo_task" invisible="1"/>
                    <field name="is_tem_replace_task" invisible="1"/>
                    <field name="is_tem_bb_replace_task" invisible="1"/>
                    <field name="is_tem_print_task" invisible="1"/>
                    <field name="is_tem_handover_task" invisible="1"/>
                    <field name="is_tem_receive_task" invisible="1"/>
                    <field name="show_work_processing_tab" invisible="1"/>
                    <field name="program_kanban_state" widget="statusbar"
                        class="ms-auto float-end"/>
                    <div class="oe_title">
                        <label for="program_name" string="Tên chương trình"/>
                        <h1>
                            <field name="program_name" readonly="1"
                                placeholder="Chưa gắn chương trình khuyến mãi"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="program_date_begin" string="Ngày"
                                widget="daterange"
                                options="{'end_date_field': 'program_date_end'}"
                                readonly="1"/>
                            <field name="program_date_end" invisible="1"/>
                            <field name="program_notify_code" readonly="1"/>
                            <field name="program_hour_quota" readonly="1"
                                placeholder="VD: 8 giờ"/>
                        </group>
                        <group>
                            <field name="program_organizer_id" readonly="1"/>
                            <field name="program_user_id" readonly="1"
                                widget="many2one_avatar_user"/>
                            <field name="user_ids" string="Người nhận việc" widget="many2many_tags"
                                readonly="1"/>
                            <field name="pending_user_ids" string="Chưa hoàn thành"
                                widget="many2many_tags" readonly="1"
                                invisible="not pending_user_ids"/>
                            <field name="program_company_id" readonly="1"
                                groups="base.group_multi_company"/>
                            <field name="program_address_id" readonly="1"
                                context="{'show_address': 1}"/>
                            <field name="program_event_url" readonly="1"
                                invisible="program_address_id" widget="url"/>
                            <label for="program_seats_limited" string="Giới hạn đăng ký"/>
                            <div>
                                <field name="program_seats_limited" readonly="1"/>
                                <span invisible="not program_seats_limited">
                                   đến <field name="program_seats_max" class="oe_inline" readonly="1"/> Người tham gia
                                </span>
                            </div>
                        </group>
                    </group>
                    <notebook>
                        <page string="Chi tiết công việc" name="task_detail">
                            <group string="Thời gian">
                                <field name="time_line_ids" nolabel="1" colspan="2"
                                    widget="one2many"
                                    class="o_ctkm_time_table">
                                    <list editable="bottom" create="1" delete="1"
                                        class="o_ctkm_time_table">
                                        <field name="sequence" column_invisible="1"/>
                                        <field name="is_main" column_invisible="1"/>
                                        <field name="name" string="Nội dung"/>
                                        <field name="date_start"/>
                                        <field name="date_end"/>
                                        <field name="total_days_display" readonly="1"
                                            width="120px"/>
                                    </list>
                                </field>
                            </group>
                            <group>
                                <group string="Import Tem/Tag" invisible="not is_tem_tag_import_task">
                                    <div class="text-muted mb-2" colspan="2">
                                        Nhấn <b>Import Tem/Tag</b> để tải lên file Excel theo mẫu Kho Tem/Tag.
                                    </div>
                                    <button name="action_open_tem_tag_import" type="object"
                                        string="Import Tem/Tag" class="btn-primary"
                                        icon="fa-file-excel-o"
                                        invisible="not is_tem_tag_import_task"/>
                                </group>
                                <group string="Ảnh tem/tag" invisible="not is_tem_photo_task">
                                    <field name="detail_tem_photo_ids" widget="many2many_binary" nolabel="1" colspan="2"
                                        options="{'accepted_file_extensions': '.png,.jpg,.jpeg,.gif,.webp'}"/>
                                </group>
                                <group string="Thông tin khác" invisible="is_tem_tag_import_task or is_tem_photo_task or is_tem_replace_task or show_work_processing_tab">
                                    <div colspan="2" class="text-muted">
                                        Đang để trống, sẽ bổ sung sau.
                                    </div>
                                </group>
                            </group>
                            <group string="Chi tiết tem/tag" name="tem_tag_detail_group"
                                invisible="not is_tem_replace_task and not is_tem_bb_replace_task and not is_tem_tag_import_task">
                                <div colspan="2" class="text-muted mb-2"
                                    invisible="not is_tem_replace_task">
                                    Nhập <b>Tổng SL đã thay</b> cho từng Mã vật tư thuộc cửa hàng của bạn trong chương trình này.
                                </div>
                                <div colspan="2" class="text-muted mb-2"
                                    invisible="not is_tem_tag_import_task">
                                    Tem/tag lấy từ sheet <b>TEM</b> và <b>TAG</b> của file tổng (tất cả cửa hàng).
                                    Mỗi dòng chỉ tích <b>Tem</b> hoặc <b>Tag</b> theo sheet chứa mã + cửa hàng đó.
                                </div>
                                <div colspan="2" class="text-muted mb-2"
                                    invisible="not is_tem_bb_replace_task">
                                    Chỉ hiện tem/tag thuộc cửa hàng trong <b>Cửa hàng quản lí</b> của bạn
                                    (Nhân viên → Cấu hình). Cột <b>GHI CHÚ</b> lấy nội dung CTKM từ file import.
                                </div>
                                <div colspan="2" class="mb-2"
                                    invisible="not is_tem_tag_import_task and not is_tem_bb_replace_task">
                                    <button name="action_refresh_tem_tag_lines" type="object"
                                        string="Làm mới danh sách" class="btn-secondary btn-sm"
                                        icon="fa-refresh"/>
                                </div>
                                <field name="tem_tag_replace_ids" nolabel="1" colspan="2"
                                    readonly="not is_tem_replace_task">
                                    <list editable="bottom" create="0" delete="0"
                                        default_group_by="store">
                                        <field name="store" readonly="1"
                                            column_invisible="parent.is_tem_replace_task"/>
                                        <field name="material_code" readonly="1"/>
                                        <field name="date" readonly="1" optional="hide"/>
                                        <field name="is_tem"
                                            column_invisible="not parent.is_tem_tag_import_task"/>
                                        <field name="is_tag"
                                            column_invisible="not parent.is_tem_tag_import_task"/>
                                        <field name="total_quantity" readonly="1" sum="Tổng SL"/>
                                        <field name="replaced_quantity" sum="Tổng SL đã thay"
                                            column_invisible="parent.is_tem_tag_import_task"/>
                                        <field name="remaining_quantity" readonly="1"
                                            sum="Tổng SL chưa thay"
                                            column_invisible="parent.is_tem_tag_import_task"/>
                                        <field name="ctkm_name" readonly="1"
                                            column_invisible="not parent.is_tem_bb_replace_task"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                        <page string="Thiết kế mẫu tem/tag" name="task_tem_design"
                            invisible="not is_tem_design_task">
                            <group string="Thiết kế mẫu tem/tag, Bảng nhận diện">
                                <div colspan="2" class="text-muted mb-2">
                                    Mỗi dòng là một <b>Mã vật tư</b> lấy từ bảng
                                    <b>Chi tiết tem/tag</b> của chương trình. Tải lên
                                    file mẫu thiết kế (PDF / ảnh) cho từng mã vật tư.
                                </div>
                                <div colspan="2" class="mb-2">
                                    <button name="action_refresh_tem_design_lines" type="object"
                                        string="Làm mới danh sách" class="btn-secondary btn-sm"
                                        icon="fa-refresh"/>
                                </div>
                                <field name="tem_design_ids" nolabel="1" colspan="2"
                                    widget="one2many" class="o_ctkm_tem_design_list">
                                    <list editable="bottom" create="0" delete="0"
                                        default_order="material_code">
                                        <field name="material_code" readonly="1"/>
                                        <field name="filename" column_invisible="1"/>
                                        <field name="file" filename="filename" widget="binary"
                                            options="{'accepted_file_extensions': '.pdf,.png,.jpg,.jpeg,.gif,.webp'}"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                        <page string="Ghi chú &amp; Tài liệu" name="task_notes">
                            <group>
                                <group string="Nhãn chương trình">
                                    <field name="program_badge_format" readonly="1"/>
                                    <field name="program_badge_image" widget="image"
                                        readonly="1"
                                        options="{'accepted_file_extensions': 'image/*'}"/>
                                </group>
                                <group string="Tài liệu gửi kèm thông báo">
                                    <field name="program_notify_document_ids"
                                        widget="many2many_binary" nolabel="1" colspan="2"
                                        readonly="1"/>
                                </group>
                                <group string="Nhận từ chương trình / bước trước"
                                    invisible="not handover_note and not handover_document_ids">
                                    <field name="notify_step_label" readonly="1"/>
                                    <label for="handover_note" string="Ghi chú nhận được"/>
                                    <br/>
                                    <field name="handover_note" nolabel="1" colspan="2"
                                        readonly="1"/>
                                    <field name="handover_document_ids"
                                        widget="many2many_binary" nolabel="1" colspan="2"
                                        readonly="1"/>
                                </group>
                                <group>
                                    <label for="program_ticket_instructions" string="Hướng dẫn vé"/>
                                    <br/>
                                    <field name="program_ticket_instructions" nolabel="1"
                                        colspan="2" readonly="1"/>
                                </group>
                                <group>
                                    <label for="program_note" string="Ghi chú chương trình"/>
                                    <br/>
                                    <field name="program_note" nolabel="1" colspan="2"
                                        readonly="1"/>
                                </group>
                                <group string="Ghi chú &amp; tài liệu của tôi">
                                    <field name="work_note" nolabel="1" colspan="2"
                                        placeholder="Thêm ghi chú của bạn..."/>
                                    <field name="work_document_ids" widget="many2many_binary"
                                        nolabel="1" colspan="2"
                                        options="{'accepted_file_extensions': '.pdf,.doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg'}"/>
                                </group>
                            </group>
                        </page>
                        <page string="Xử lý công việc" name="task_work_process"
                            invisible="not show_work_processing_tab">
                            <group string="Bàn giao tem/tag" invisible="not is_tem_handover_task">
                                <div colspan="2" class="text-muted mb-2">
                                    Tên cửa hàng và số lượng tem/tag lấy từ bước <b>In tem, Tag</b>.
                                </div>
                                <field name="handover_store_search" placeholder="Tìm cửa hàng..."
                                    nolabel="1" colspan="2"/>
                                <div colspan="2" class="mb-2">
                                    <button name="action_refresh_tem_tag_lines" type="object"
                                        string="Làm mới danh sách" class="btn-secondary btn-sm"
                                        icon="fa-refresh"/>
                                </div>
                                <field name="handover_store_ids" nolabel="1" colspan="2"
                                    widget="one2many"
                                    class="o_ctkm_print_store_list"
                                    context="{'default_line_type': 'handover'}"
                                    domain="[('line_type', '=', 'handover')]">
                                    <list editable="bottom" create="0" delete="0"
                                        class="o_ctkm_print_store_list"
                                        default_order="sequence, store">
                                        <field name="line_type" column_invisible="1"/>
                                        <field name="sequence" readonly="1" width="50px"/>
                                        <field name="store_id" readonly="1"
                                            options="{'no_create': True, 'no_open': True}"/>
                                        <field name="store_code" readonly="1" width="110px"/>
                                        <field name="store" column_invisible="1"/>
                                        <field name="store_key" column_invisible="1"/>
                                        <field name="is_manual" column_invisible="1"/>
                                        <field name="tem_quantity" readonly="1" width="90px"
                                            sum="Tổng SL tem"/>
                                        <field name="tag_quantity" readonly="1" width="90px"
                                            sum="Tổng SL tag"/>
                                        <field name="done" width="80px"/>
                                    </list>
                                </field>
                            </group>
                            <group string="Thu tem/tag" invisible="not is_tem_handover_task">
                                <div colspan="2" class="text-muted mb-2">
                                    Mã cửa hàng lấy từ bước <b>In tem, Tag</b>.
                                    Điền <b>SL tem</b> / <b>SL tag</b> thu về.
                                </div>
                                <field name="collect_store_search" placeholder="Tìm cửa hàng..."
                                    nolabel="1" colspan="2"/>
                                <div colspan="2" class="mb-2">
                                    <button name="action_add_collect_store_line" type="object"
                                        string="Tạo dòng" class="btn-primary btn-sm"
                                        icon="fa-plus"/>
                                    <button name="action_refresh_tem_tag_lines" type="object"
                                        string="Làm mới danh sách" class="btn-secondary btn-sm ms-2"
                                        icon="fa-refresh"/>
                                </div>
                                <field name="collect_store_ids" nolabel="1" colspan="2"
                                    widget="one2many"
                                    class="o_ctkm_print_store_list"
                                    context="{'default_line_type': 'collect'}"
                                    domain="[('line_type', '=', 'collect')]">
                                    <list editable="bottom" create="1" delete="1"
                                        class="o_ctkm_print_store_list"
                                        default_order="sequence, store">
                                        <field name="line_type" column_invisible="1"/>
                                        <field name="sequence" readonly="1" width="50px"/>
                                        <field name="store_id"
                                            options="{'no_create': True, 'no_open': True}"
                                            placeholder="Tìm cửa hàng..."/>
                                        <field name="store_code" readonly="1" width="110px"/>
                                        <field name="store" column_invisible="1"/>
                                        <field name="store_key" column_invisible="1"/>
                                        <field name="is_manual" column_invisible="1"/>
                                        <field name="tem_quantity" width="90px" sum="Tổng SL tem"/>
                                        <field name="tag_quantity" width="90px" sum="Tổng SL tag"/>
                                        <field name="done" width="80px"/>
                                    </list>
                                </field>
                            </group>
                            <group invisible="not is_tem_print_task">
                                <div colspan="2" class="text-muted mb-2">
                                    Danh sách cửa hàng cần in tem/tag theo file tổng, đã cộng dồn số lượng theo cửa hàng (không tách từng mã tem).
                                    Tick <b>Kết quả</b> để chuyển cửa hàng xuống bảng đã hoàn thành.
                                </div>
                                <field name="print_store_search" placeholder="Tìm cửa hàng..."
                                    nolabel="1" colspan="2"/>
                                <div colspan="2" class="mb-2">
                                    <button name="action_add_print_store_line" type="object"
                                        string="Tạo dòng" class="btn-primary btn-sm"
                                        icon="fa-plus"/>
                                    <button name="action_refresh_tem_tag_lines" type="object"
                                        string="Làm mới danh sách" class="btn-secondary btn-sm ms-2"
                                        icon="fa-refresh"/>
                                </div>
                                <separator string="Thông tin cửa hàng và số lượng tem/tag cần in"
                                    colspan="2"/>
                                <field name="print_store_pending_ids" nolabel="1" colspan="2"
                                    widget="one2many"
                                    class="o_ctkm_print_store_list"
                                    context="{'default_done': False}"
                                    domain="[('done', '=', False), ('store', 'ilike', print_store_search or '%')]">
                                    <list editable="bottom" create="1" delete="1"
                                        class="o_ctkm_print_store_list"
                                        default_order="sequence, store">
                                        <field name="sequence" readonly="1" width="50px"/>
                                        <field name="store_id"
                                            options="{'no_create': True, 'no_open': True}"
                                            placeholder="Tìm cửa hàng..."/>
                                        <field name="store_code" readonly="1" width="110px"/>
                                        <field name="store" column_invisible="1"/>
                                        <field name="store_key" column_invisible="1"/>
                                        <field name="is_manual" column_invisible="1"/>
                                        <field name="tem_quantity" width="90px" sum="Tổng SL tem"/>
                                        <field name="tag_quantity" width="90px" sum="Tổng SL tag"/>
                                        <field name="done" column_invisible="1"/>
                                        <button name="action_toggle_print_done" type="object"
                                            class="btn btn-link p-0 o_ctkm_print_done_btn"
                                            icon="fa-square-o"
                                            invisible="done"
                                            title="Tick khi đã in xong"
                                            string="Kết quả"/>
                                        <button name="action_toggle_print_done" type="object"
                                            class="btn btn-link p-0 o_ctkm_print_done_btn"
                                            icon="fa-check-square-o"
                                            invisible="not done"
                                            title="Bỏ tick để đưa lại bảng cần in"
                                            string="Kết quả"/>
                                    </list>
                                </field>
                                <separator string="Cửa hàng đã hoàn thành in tem/tag"
                                    colspan="2"/>
                                <field name="print_store_done_ids" nolabel="1" colspan="2"
                                    widget="one2many"
                                    class="o_ctkm_print_store_list"
                                    context="{'default_done': True}"
                                    domain="[('done', '=', True), ('store', 'ilike', print_store_search or '%')]">
                                    <list editable="bottom" create="0" delete="1"
                                        class="o_ctkm_print_store_list"
                                        default_order="sequence, store">
                                        <field name="sequence" readonly="1" width="50px"/>
                                        <field name="store_id"
                                            options="{'no_create': True, 'no_open': True}"
                                            placeholder="Tìm cửa hàng..."/>
                                        <field name="store_code" readonly="1" width="110px"/>
                                        <field name="store" column_invisible="1"/>
                                        <field name="store_key" column_invisible="1"/>
                                        <field name="is_manual" column_invisible="1"/>
                                        <field name="tem_quantity" width="90px" sum="Tổng SL tem"/>
                                        <field name="tag_quantity" width="90px" sum="Tổng SL tag"/>
                                        <field name="done" column_invisible="1"/>
                                        <button name="action_toggle_print_done" type="object"
                                            class="btn btn-link p-0 o_ctkm_print_done_btn"
                                            icon="fa-square-o"
                                            invisible="done"
                                            title="Tick khi đã in xong"
                                            string="Kết quả"/>
                                        <button name="action_toggle_print_done" type="object"
                                            class="btn btn-link p-0 o_ctkm_print_done_btn"
                                            icon="fa-check-square-o"
                                            invisible="not done"
                                            title="Bỏ tick để đưa lại bảng cần in"
                                            string="Kết quả"/>
                                        <field name="done_date" readonly="1" width="120px"
                                            optional="show"/>
                                    </list>
                                </field>
                            </group>
                            <group string="Chi tiết tem/tag"
                                invisible="not is_tem_receive_task">
                                <div colspan="2" class="text-muted mb-2"
                                    invisible="not is_tem_receive_task">
                                    Tem/tag mới cần nhận cho cửa hàng của bạn.
                                </div>
                                <div colspan="2" class="mb-2">
                                    <button name="action_refresh_tem_tag_lines" type="object"
                                        string="Làm mới danh sách" class="btn-secondary btn-sm"
                                        icon="fa-refresh"/>
                                </div>
                                <field name="tem_tag_replace_ids" nolabel="1" colspan="2"
                                    readonly="1">
                                    <list create="0" delete="0" default_group_by="store">
                                        <field name="store" readonly="1"/>
                                        <field name="material_code" readonly="1"/>
                                        <field name="date" readonly="1" optional="hide"/>
                                        <field name="total_quantity" readonly="1" sum="Tổng SL"/>
                                        <field name="replaced_quantity" readonly="1"
                                            sum="Tổng SL đã thay"/>
                                        <field name="remaining_quantity" readonly="1"
                                            sum="Tổng SL chưa thay"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                        <page string="Yêu cầu hỗ trợ" name="task_support">
                            <group>
                                <group>
                                    <field name="handover_date"/>
                                    <field name="handover_employee_id"
                                        options="{'no_create': True}"/>
                                    <field name="duration" placeholder="VD: 2 giờ"/>
                                </group>
                                <group>
                                    <field name="support_employee_ids" widget="many2many_tags"
                                        options="{'no_create': True}"/>
                                    <div colspan="2" class="mt-2">
                                        <button name="action_notify_support" type="object"
                                            string="Gửi yêu cầu hỗ trợ" class="btn-primary"
                                            icon="fa-bell"/>
                                    </div>
                                </group>
                            </group>
                        </page>
                        <page string="Xác nhận quản lý" name="task_manager_confirm" invisible="not checklist_need_manager_confirm">
                                <group>
                                    <group>
                                        <field name="verifier_id" readonly="1"
                                            invisible="not verifier_id"/>
                                        <field name="manager_confirmed"
                                            readonly="state != 'waiting_confirm' or not can_confirm_as_manager"/>
                                    <div colspan="2" class="text-muted"
                                        invisible="state == 'waiting_confirm'">
                                        Chỉ xác nhận được sau khi công việc đã bấm Hoàn thành.
                                    </div>
                                        <div colspan="2" class="text-muted"
                                            invisible="state != 'waiting_confirm' or can_confirm_as_manager or not verifier_id">
                                            Chỉ <b>Người kiểm soát</b> (<field name="verifier_id" readonly="1" nolabel="1"/>) mới được tick xác nhận.
                                        </div>
                                        <div colspan="2" class="text-muted"
                                            invisible="state != 'waiting_confirm' or can_confirm_as_manager or verifier_id">
                                            Chỉ quản lý trực tiếp (theo organization chart) mới được tick xác nhận.
                                        </div>
                                    <div colspan="2" class="text-muted"
                                        invisible="state != 'waiting_confirm' or not can_confirm_as_manager or manager_confirmed">
                                        Bấm nút <b>Xác nhận quản lý</b> trên đầu form, hoặc tick ô bên trên.
                                    </div>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_ctkm_task_search" model="ir.ui.view">
        <field name="name">ctkm.task.search</field>
        <field name="model">ctkm.task</field>
        <field name="arch" type="xml">
            <search string="Công việc của tôi">
                <field name="name"/>
                <field name="program_id"/>
                <field name="user_ids"/>
                <field name="is_current_stage_task" invisible="1"/>
                <filter string="Bước hiện tại" name="is_current_stage_task"
                    domain="[('is_current_stage_task', '=', True)]"/>
                <filter string="Của tôi" name="my_tasks"
                    domain="[('user_ids', 'in', [uid])]"/>
                <filter string="Chờ tôi xác nhận" name="waiting_my_confirm"
                    domain="[('state', '=', 'waiting_confirm'), ('user_ids.employee_ids.parent_id.user_id', 'in', [uid])]"/>
                <separator/>
                <filter string="Chưa bắt đầu" name="state_todo"
                    domain="[('state', '=', 'todo')]"/>
                <filter string="Đang xử lý" name="state_progress"
                    domain="[('state', '=', 'progress')]"/>
                <filter string="Chờ xác nhận" name="state_waiting_confirm"
                    domain="[('state', '=', 'waiting_confirm')]"/>
                <filter string="Hoàn thành" name="state_done"
                    domain="[('state', '=', 'done')]"/>
                <group>
                    <filter string="Tên CTKM" name="group_program_id"
                        context="{'group_by': 'program_id'}"/>
                    <filter string="Trạng thái" name="group_state"
                        context="{'group_by': 'state'}"/>
                    <filter string="Ngày bắt đầu" name="group_process_date"
                        context="{'group_by': 'process_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ctkm_task_my" model="ir.actions.act_window">
        <field name="name">Công việc của tôi</field>
        <!-- Không dùng path (ctkm-my-tasks): webclient Odoo 19 đôi khi
             hiểu nhầm path thành model name → RPC 404 KeyError.
             Deep link dùng /odoo/ctkm.task/<id>?menu_id=<app menu>. -->
        <field name="path" eval="False"/>
        <field name="res_model">ctkm.task</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ctkm_task_search"/>
        <!-- Chỉ việc của tôi + việc cấp dưới chờ mình xác nhận (không hiện chung cả hệ thống). -->
        <field name="domain">['|',
            ('user_ids', 'in', [uid]),
            '&amp;',
                ('state', '=', 'waiting_confirm'),
                ('user_ids.employee_ids.parent_id.user_id', 'in', [uid])]</field>
        <field name="context">{'search_default_is_current_stage_task': 1,
            'search_default_group_program_id': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Chưa có công việc nào.
            </p>
            <p>
                Công việc được tạo tự động từ <b>Tiến độ thực hiện</b> của chương trình,
                hoặc khi bấm <b>Gửi tin</b> trong chương trình.
            </p>
        </field>
    </record>

    <record id="menu_ctkm_my_tasks" model="ir.ui.menu">
        <field name="action" ref="action_ctkm_task_my"/>
    </record>

    <record id="ctkm_main_menu" model="ir.ui.menu">
        <field name="action" ref="action_ctkm_task_my"/>
    </record>

</odoo>
