<?xml version="1.0"?>
<odoo noupdate="0">

    <!-- App CTKM: mọi user nội bộ thấy.
         Chương trình KM / Cấu hình vẫn chỉ CTKM User / Manager. -->
    <record id="ctkm_main_menu" model="ir.ui.menu">
        <field name="name">CTKM</field>
        <field name="sequence">126</field>
        <field name="group_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="web_icon">ctkm_core,static/description/icon.png</field>
    </record>

    <record id="menu_ctkm_program" model="ir.ui.menu">
        <field name="name">Chương trình khuyến mãi</field>
        <field name="sequence">1</field>
        <field name="parent_id" ref="ctkm_core.ctkm_main_menu"/>
        <field name="group_ids" eval="[(4, ref('ctkm_core.group_ctkm_user'))]"/>
    </record>

    <record id="menu_ctkm_my_tasks" model="ir.ui.menu">
        <field name="name">Công việc của tôi</field>
        <field name="sequence">2</field>
        <field name="parent_id" ref="ctkm_core.ctkm_main_menu"/>
        <field name="group_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="menu_ctkm_report" model="ir.ui.menu">
        <field name="name">Báo cáo</field>
        <field name="sequence">3</field>
        <field name="parent_id" ref="ctkm_core.ctkm_main_menu"/>
        <field name="group_ids" eval="[(4, ref('ctkm_core.group_ctkm_user'))]"/>
    </record>

    <record id="menu_ctkm_configuration" model="ir.ui.menu">
        <field name="name">Cấu hình</field>
        <field name="sequence">99</field>
        <field name="parent_id" ref="ctkm_core.ctkm_main_menu"/>
        <field name="group_ids" eval="[(4, ref('ctkm_core.group_ctkm_manager'))]"/>
    </record>

    <record id="menu_ctkm_stage" model="ir.ui.menu">
        <field name="name">Giai đoạn</field>
        <field name="sequence">1</field>
        <field name="parent_id" ref="ctkm_core.menu_ctkm_configuration"/>
    </record>

</odoo>
